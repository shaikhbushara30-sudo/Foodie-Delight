<%- include('../partials/admin-head') %>

<div class="dashboard-panel">
    <h3>Order #<%= order.id %></h3>
    <p><strong>Placed:</strong> <%= new Date(order.created_at).toLocaleString() %></p>
    <p><strong>Delivery Address:</strong> <%= order.delivery_address || 'N/A' %></p>
    <p><strong>Payment Method:</strong> <%= order.payment_method === 'online' ? 'Paid Online (Razorpay)' : 'Cash on Delivery' %>
        &nbsp;<span class="payment-badge <%= order.payment_status %>"><%= order.payment_status %></span>
    </p>
    <% if (order.razorpay_payment_id) { %>
        <p><strong>Razorpay Payment ID:</strong> <%= order.razorpay_payment_id %></p>
    <% } %>
    <p><strong>Current Status:</strong> <span class="order-status status-<%= order.status %>"><%= order.status.replace(/_/g,' ') %></span></p>

    <table class="admin-table">
        <thead><tr><th>Item</th><th>Price</th><th>Qty</th><th>Subtotal</th></tr></thead>
        <tbody>
            <% order.items.forEach(item => { %>
                <tr>
                    <td><%= item.item_name %></td>
                    <td>₹<%= Number(item.item_price).toFixed(2) %></td>
                    <td><%= item.quantity %></td>
                    <td>₹<%= (item.item_price * item.quantity).toFixed(2) %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <h3 style="text-align:right;">Total: ₹<%= Number(order.total_amount).toFixed(2) %></h3>

    <form action="/admin/orders/<%= order.id %>/status" method="POST" class="admin-form status-form">
        <div class="form-group">
            <label for="status">Update Status</label>
            <select name="status" id="status">
                <% statuses.forEach(s => { %>
                    <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s.replace(/_/g,' ') %></option>
                <% }) %>
            </select>
        </div>
        <button type="submit" class="btn-primary">Update Status</button>
    </form>

    <a href="/admin/orders" class="btn-small">Back to Orders</a>
</div>

<%- include('../partials/admin-foot') %>
