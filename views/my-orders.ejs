<section class="orders-page">
    <div class="container">
        <h1>My Orders</h1>

        <% if (orders && orders.length) { %>
            <div class="orders-list">
                <% orders.forEach(order => { %>
                    <div class="order-card">
                        <div class="order-card-header">
                            <h3>Order #<%= order.id %></h3>
                            <span class="order-status status-<%= order.status %>"><%= order.status.replace(/_/g, ' ') %></span>
                        </div>
                        <p>Placed on: <%= new Date(order.created_at).toLocaleString() %></p>
                        <p>Total: ₹<%= Number(order.total_amount).toFixed(2) %></p>
                        <p>
                            <%= order.payment_method === 'online' ? 'Paid Online' : 'Cash on Delivery' %>
                            &nbsp;<span class="payment-badge <%= order.payment_status %>"><%= order.payment_status %></span>
                        </p>
                        <a href="/orders/<%= order.id %>/bill" class="btn-primary">View Bill</a>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p>You haven't placed any orders yet. <a href="/menu">Browse the menu</a> to get started!</p>
        <% } %>
    </div>
</section>
