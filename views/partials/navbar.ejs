<header>
    <div class="container">
        <div class="logo">
            <img src="/img/logo.png" alt="Foodie Delight Logo">
            <h1>Foodie Delight</h1>
        </div>
        <nav>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/menu">Menu</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/contact">Contact</a></li>
                <% if (currentUser && currentUser.role === 'customer') { %>
                    <li><a href="/cart" id="cartLink">Cart <span class="cart-count">0</span></a></li>
                    <li><a href="/orders/my">My Orders</a></li>
                    <li class="profile-menu">
                        <a href="#" class="profile-toggle" id="profileToggle">
                            <i class="fas fa-user-circle"></i> <%= currentUser.name %> <i class="fas fa-caret-down"></i>
                        </a>
                        <ul class="dropdown-menu" id="profileDropdown">
                            <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                        </ul>
                    </li>
                <% } else if (currentUser && currentUser.role === 'admin') { %>
                    <li><a href="/admin/dashboard">Admin Dashboard</a></li>
                    <li class="profile-menu">
                        <a href="#" class="profile-toggle" id="profileToggle">
                            <i class="fas fa-user-shield"></i> <%= currentUser.name %> <i class="fas fa-caret-down"></i>
                        </a>
                        <ul class="dropdown-menu" id="profileDropdown">
                            <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                        </ul>
                    </li>
                <% } else { %>
                    <li><a href="/login">Login</a></li>
                    <li><a href="/signup">Sign Up</a></li>
                <% } %>
            </ul>
            <div class="menu-toggle" id="menuToggle">
                <i class="fas fa-bars"></i>
            </div>
        </nav>
    </div>
</header>
